NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*

# Local docker-compose Postgres. In EKS this is injected from AWS Secrets
# Manager via External Secrets, not committed anywhere.
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk

# Generate a real secret for anything beyond local dev, e.g.:
#   openssl rand -base64 48
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=12h
