{
  "name": "helpdesk-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate:up": "node --env-file=.env node_modules/.bin/node-pg-migrate up --migrations-dir migrations",
    "migrate:down": "node --env-file=.env node_modules/.bin/node-pg-migrate down --migrations-dir migrations",
    "migrate": "node-pg-migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.12.0",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
